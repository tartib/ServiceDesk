{
  "name": "servicedesk-backend",
  "version": "1.0.0",
  "description": "ServiceDesk Backend - IT Service Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:smoke": "jest --testPathPattern=smoke --verbose",
    "test:integration": "jest --testPathPattern=integration --verbose",
    "test:ci": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "seed:itsm": "ts-node src/scripts/seedITSMData.ts",
    "seed:users": "ts-node src/scripts/seedTestUsers.ts",
    "module:health": "node scripts/moduleHealth.js",
    "boundary:check": "ts-node scripts/check-boundaries.ts",
    "postinstall": "node scripts/patch-express-types.js"
  },
  "keywords": [
    "servicedesk",
    "it-service",
    "ticket-management",
    "helpdesk"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/minio": "^7.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "awilix": "^13.0.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "glob": "^11.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.7",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "8.0.5",
    "pg": "^8.19.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/glob": "^8.1.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "brace-expansion": "^2.0.3",
    "jws": "^4.0.1",
    "minimatch": "^7.4.8",
    "picomatch": "^4.0.4"
  }
}
