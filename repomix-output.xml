// Archive project
export const archiveProject = async (req: Request, res: Response): Promise<void> => {
  try {
    const { projectId } = req.params;
    const userId = req.user?.id;

    // ── PostgreSQL path ──
    if (isPmPostgres()) {
      const repo = getPmRepos().project as PgProjectRepository;
      const project = await repo.findById(projectId);
      if (!project) {
        res.status(404).json({ success: false, error: 'Project not found' } as ApiResponse);
        return;
      }
      const members = project.members || [];
      const member = members.find((m: any) => m.userId?.toString() === userId);
      if (!member || member.role !== ProjectRole.LEAD) {
        res.status(403).json({ success: false, error: 'Only project lead can archive the project' } as ApiResponse);
        return;
      }
      const updated = await repo.updateById(projectId, { status: 'archived' } as any);
      res.status(200).json({ success: true, data: { project: updated }, message: 'Project archived successfully' } as ApiResponse);
      return;
    }

    // ── MongoDB path ──
    const project = await Project.findById(projectId);
    if (!project) {
      res.status(404).json({
        success: false,
        error: 'Project not found',
      } as ApiResponse);
      return;
    }

    // Only lead can archive
    const member = project.members.find((m) => m.userId?.toString() === userId);
    if (!member || member.role !== ProjectRole.LEAD) {
      res.status(403).json({
        success: false,
        error: 'Only project lead can archive the project',
      } as ApiResponse);
      return;
    }

    project.status = 'archived' as any;
    await project.save();

    res.status(200).json({
      success: true,
      data: { project },
      message: 'Project archived successfully',
    } as ApiResponse);
  } catch (error) {
    logger.error('Archive project error:', error);
    res.status(500).json({
      success: false,
      error: 'Failed to archive project',
    } as ApiResponse);
  }
};

