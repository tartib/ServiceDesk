 const isPast = end < new Date();

 return (
 <div
 key={h.id}
 className={`flex items-start gap-3 p-4 rounded-lg border ${isPast ? 'bg-muted opacity-60' : 'bg-success-soft border-success/30'}`}
 >
 <div className={`flex items-center justify-center w-10 h-10 rounded-lg shrink-0 ${isPast ? 'bg-muted' : 'bg-success-soft'}`}>
