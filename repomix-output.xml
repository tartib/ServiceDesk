import mongoose, { Document, Schema } from 'mongoose';

export enum AssetType {
  HARDWARE = 'hardware',
  SOFTWARE = 'software',
  NETWORK = 'network',
  CLOUD = 'cloud',
  VIRTUAL = 'virtual',
  PERIPHERAL = 'peripheral',
  MOBILE = 'mobile',
  OTHER = 'other',
}

export enum AssetStatus {
  ACTIVE = 'active',
  INACTIVE = 'inactive',
  IN_STOCK = 'in_stock',
  IN_MAINTENANCE = 'in_maintenance',
  RETIRED = 'retired',
  DISPOSED = 'disposed',
  LOST = 'lost',
  RESERVED = 'reserved',
}

export enum AssetCondition {
  NEW = 'new',
  GOOD = 'good',
  FAIR = 'fair',
  POOR = 'poor',
  DAMAGED = 'damaged',
}

export interface IAsset extends Document {
  asset_id: string;
  name: string;
  name_ar?: string;
  description?: string;
  description_ar?: string;
  type: AssetType;
  status: AssetStatus;
  condition: AssetCondition;
  
  // Identification
