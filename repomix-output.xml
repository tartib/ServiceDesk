<file path="ServiceDesk-app/app/(dashboard)/projects/[projectId]/reports/page.tsx">
'use client';

import { API_URL } from '@/lib/api/config';
import { useEffect, useState, useCallback } from 'react';
import { useParams, useRouter } from 'next/navigation';
import {
 FileText,
 Download,
 Calendar,
 BarChart3,
 PieChart,
 TrendingUp,
 Clock,
 Users,
 Filter,
 Plus,
} from 'lucide-react';
import {
 ProjectHeader,
 ProjectNavTabs,
 LoadingState,
} from '@/components/projects';
import { useMethodology } from '@/hooks/useMethodology';

interface Report {
 id: string;
 name: string;
 type: 'velocity' | 'burndown' | 'sprint' | 'team' | 'custom';
 description: string;
 lastGenerated?: string;
 schedule?: 'daily' | 'weekly' | 'monthly' | 'manual';
 icon: 'bar' | 'pie' | 'line' | 'table';
}

interface Project {
 _id: string;
 name: string;
 key: string;
}

interface BackendReport {
 _id: string;
 name: string;
 type: Report['type'];
 description: string;
