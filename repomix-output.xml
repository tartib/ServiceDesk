    expect(res.status).toBe(200);
    expect(res.body.data.every((t: any) => t.type === 'support')).toBe(true);
  });

  it('200 — search by name', async () => {
    const res = await authReq(request(app).get('/api/v1/teams?search=Alpha'), prepUser);
    expect(res.status).toBe(200);
