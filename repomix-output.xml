 return;
 }

 if (e.shiftKey && e.key === 'C') {
 e.preventDefault();
 setShowCreateSubtaskModal(true);
 } else if (e.shiftKey && e.key === 'K') {
 e.preventDefault();
 setShowLinkSection(true);
 }
 };

 document.addEventListener('keydown', handleGlobalKeyDown);
