        category_id: options?.category_id,
        tags: options?.tags,
      }) as IApiResponse<IDeflectionResult>;
      return response.data;
    },
    enabled: (options?.enabled ?? true) && title.length >= 5,
    staleTime: 30_000,
  });
};

