  canUpdateTask: jest.fn().mockReturnValue(true),
  canAssignTask: jest.fn().mockReturnValue(true),
  getTaskPermissions: jest.fn().mockReturnValue({
    canUpdate: true, canDelete: true, canAssign: true, canTransition: true,
