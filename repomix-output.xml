      api.post.mockRejectedValueOnce(new Error('Creation failed'));

      const { result } = renderHook(() => useCreateTask(), {
        wrapper: createWrapper(),
      });

      result.current.mutate({
        projectId: 'project-123',
        name: 'New Task',
      } as any);

      await waitFor(() => {
        expect(result.current.isError).toBe(true);
      });
    });
