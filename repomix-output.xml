 )}

 {/* Task Cards */}
 {tasks.map((task) => (
 <TaskCard
 key={task._id}
 taskKey={task.key}
 title={task.title}
 type={task.type}
 priority={task.priority}
 status={task.status}
 assignee={task.assignee}
