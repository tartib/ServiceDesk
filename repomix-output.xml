      );
    });

    it('useTasksByStatus → GET /projects/:projectId/tasks?status=:status', async () => {
      mockApi.get.mockResolvedValueOnce({ data: [] });
      renderHook(() => useTasksByStatus('p1', 'scheduled'), { wrapper });
