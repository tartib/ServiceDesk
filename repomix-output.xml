  MAINTENANCE_WINDOW = 'maintenance_window',
  CAB_MEETING = 'cab_meeting',
}

// ============================================
// INTERFACES - Common
// ============================================

export interface IRequester {
  id: string;
  name: string;
  email: string;
  department: string;
  phone?: string;
  site_id?: string;
