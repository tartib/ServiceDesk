 variant="board"
 />
 ))}

 {/* Empty State */}
 {tasks.length === 0 && !showCreateButton && (
 <div className="text-center py-8 text-muted-foreground text-sm">
 {emptyMessage}
 </div>
 )}
 </div>
 </div>
 );
}
</file>

