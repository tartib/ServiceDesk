 });
 if (response.ok) {
 const data = await response.json();
 const user = data.data || data;
 setCurrentUser({
 _id: user.id,
 profile: user.profile || { firstName: user.firstName || '', lastName: user.lastName || '' },
 permissions: { canEditTasks: true, isAdmin: user.role === 'admin' },
 });
 }
 } catch (error) {
