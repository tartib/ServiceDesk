 {sprint.stats ? `${sprint.stats.completedPoints}/${sprint.stats.totalPoints}` : '-'}
 </td>
 <td className="py-2 text-muted-foreground">
 {new Date(sprint.startDate).toLocaleDateString()} — {new Date(sprint.endDate).toLocaleDateString()}
 </td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 )}
 </div>
 </div>
 );
}
