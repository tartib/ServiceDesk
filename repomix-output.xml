/**
 * ITSM Domain — API Functions
 *
 * All ITSM API calls go through the unified axios client.
 * These functions are consumed by the domain hooks.
 */

import api from '@/lib/axios';

const BASE = '/itsm';

// ── Incidents ──────────────────────────────────────────────────

