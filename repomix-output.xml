 </div>
 {averageVelocity > 0 && (
 <div className={`text-xs ${velocityComparison >= 0 ? 'text-success' : 'text-destructive'}`}>
 {velocityComparison >= 0 ? '+' : ''}{velocityComparison}% vs avg
 </div>
 )}
