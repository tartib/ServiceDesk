  [
    param('projectId').isMongoId().withMessage('Invalid project ID'),
    param('transitionId').trim().notEmpty().withMessage('Transition ID is required'),
  ],
  handleValidation,
  (req: Request, res: Response) => workflowController.deleteTransition(req, res)
