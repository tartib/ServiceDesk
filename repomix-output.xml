 onChange={(e) => setSearchQuery(e.target.value)}
 placeholder={locale === 'ar' ? 'ابحث عن خدمة...' : 'Search services...'}
 className="pl-10"
 dir={locale === 'ar' ? 'rtl' : 'ltr'}
 />
 </div>
