      .send({
        name: 'Main Inbox',
        name_ar: 'صندوق الوارد الرئيسي',
        ticket_types: ['incident', 'service_request'],
        is_default: true,
      });
    expect(res.status).toBe(201);
    expect(res.body.data.is_default).toBe(true);
