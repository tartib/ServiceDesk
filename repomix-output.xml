export interface DomainEvent<T = unknown> {
  // Metadata
  id: string;                     // UUID
  type: string;                   // Event type (e.g., 'ops.work_order.created')
  timestamp: string;              // ISO 8601
  version: string;                // Schema version

  // Context
  organizationId: string;
