        type: Number,
        default: 100,
      },
    },
    schedule: {
      cron: String,
      timezone: String,
      enabled: Boolean,
      lastRun: Date,
      nextRun: Date,
    },
    scope: {
      ticketTypes: [String],
      services: [String],
      categories: [String],
      priorities: [String],
      applyTo: {
        type: String,
        enum: ['all', 'specific'],
        default: 'all',
      },
    },
    stats: {
      executionCount: {
        type: Number,
        default: 0,
      },
      successCount: {
        type: Number,
        default: 0,
      },
