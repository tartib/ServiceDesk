    sla: { type: WFStateSLASchema },
    requiredFields: [{ type: String }],
    metadata: { type: Schema.Types.Mixed },
    parallelBranches: [{ type: String }],
    joinStrategy: { type: String, enum: Object.values(WFJoinStrategy) },
