 if (!dateString) return '-';
 return new Date(dateString).toLocaleDateString(locale === 'ar' ? 'ar-SA' : 'en-US', {
 year: 'numeric',
 month: 'long',
 day: 'numeric',
 });
 };

 if (isLoading) {
