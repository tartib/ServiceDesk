import { Label } from '@/components/ui/label';
import { cn } from '@/lib/utils';
import { RenderedField } from '@/types/smart-forms';

interface DateFieldProps {
 field: RenderedField;
 value: string;
 onChange: (value: string) => void;
 onBlur?: () => void;
 error?: string;
 disabled?: boolean;
 locale?: 'en' | 'ar';
}

export default function DateField({
 field,
 value,
