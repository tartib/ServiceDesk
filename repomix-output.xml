  assignee?: mongoose.Types.ObjectId;
  reporter: mongoose.Types.ObjectId;
  labels: string[];
  components: string[];
  storyPoints?: number;
  originalEstimate?: number;
  remainingEstimate?: number;
  timeSpent?: number;
