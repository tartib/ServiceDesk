      ticketId: row.ticket_id,
      ticketType: row.ticket_type,
      policyId: row.policy_id,
      status: row.status,
      startedAt: row.started_at,
      stoppedAt: row.stopped_at,
      createdAt: row.created_at,
      updatedAt: row.updated_at,
    };
  }
}
