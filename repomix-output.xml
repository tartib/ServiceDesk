      unique: true,
    },
    name: {
      type: String,
      required: true,
      trim: true,
    },
    name_ar: {
      type: String,
      trim: true,
    },
    description: String,
    description_ar: String,
    type: {
      type: String,
      enum: Object.values(AssetType),
      required: true,
      default: AssetType.HARDWARE,
    },
    status: {
      type: String,
      enum: Object.values(AssetStatus),
      default: AssetStatus.IN_STOCK,
    },
    condition: {
