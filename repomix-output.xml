    return (res.rowCount ?? 0) > 0;
  }

  // ── Row mappers ────────────────────────────────────────────

  private mapRow(row: any): ISlaPolicyEntity {
    return {
      id: row.id,
      tenantId: row.tenant_id,
      code: row.code,
      name: row.name,
      nameAr: row.name_ar,
