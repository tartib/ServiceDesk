  teamId?: string;
  startDate?: string;
  endDate?: string;
  type?: LeaveType;
  status?: LeaveStatus;
  page?: number;
  limit?: number;
}) {
  return useQuery({
    queryKey: leaveRequestKeys.list(filters || {}),
