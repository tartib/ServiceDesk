 {isAr ? 'مدة القفل (ثواني)' : 'Lock Timeout (seconds)'}
 </Label>
 <Input
 id="ext-timeout"
 type="number"
 min={10}
 value={String(nodeData.timeout ?? 300)}
 onChange={(e) =>
 onNodeChange(selectedNode.id, {
 ...nodeData,
 timeout: e.target.value ? Number(e.target.value) : 300,
 })
 }
 placeholder="300"
 className="mt-1"
 />
 </div>

 <div>
 <Label htmlFor="ext-priority" className="text-xs text-muted-foreground">
 {isAr ? 'الأولوية' : 'Priority'}
 </Label>
 <Input
 id="ext-priority"
 type="number"
 min={0}
 value={String(nodeData.priority ?? 0)}
 onChange={(e) =>
 onNodeChange(selectedNode.id, {
 ...nodeData,
 priority: e.target.value ? Number(e.target.value) : 0,
 })
 }
 className="mt-1"
 />
 </div>

 <div>
