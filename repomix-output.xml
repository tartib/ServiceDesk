const WFStateDefinitionSchema = new Schema(
  {
    code: { type: String, required: true },
    name: { type: String, required: true },
    nameAr: { type: String },
    description: { type: String },
    type: { type: String, enum: Object.values(WFStateType), default: WFStateType.NORMAL },
