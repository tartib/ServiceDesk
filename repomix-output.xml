  return useMutation({
    mutationFn: async ({
      changeId,
      decision,
      comments,
      role,
    }: {
      changeId: string;
      decision: ApprovalStatus;
      comments?: string;
      role?: string;
    }) => {
      const response = await api.post<{ data: { change: IChange } }>(
        `${ITSM_BASE}/changes/${changeId}/cab/approve`,
