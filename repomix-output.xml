      planned_start: string;
      planned_end: string;
      site_id?: string;
    }) => {
      const response = await api.post(`${ITSM_BASE}/changes/validate-schedule`, data) as IApiResponse<IScheduleValidation>;
      return response.data;
    },
  });
};

