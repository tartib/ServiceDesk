    it('should handle completion without notes', async () => {
      mockApi.post.mockResolvedValueOnce({ data: { _id: 'task-1' } });

      const { result } = renderHook(() => useCompleteTask(), { wrapper });

      result.current.mutate({
        taskId: 'task-1',
      });

