 <p className="text-[10px] text-muted-foreground mt-1">
 {days} {days === 1
 ? (locale === 'ar' ? 'يوم' : 'day')
 : (locale === 'ar' ? 'أيام' : 'days')}
 </p>
 </div>
 </div>
 );
 })}
 </div>
 </div>
 );
 })}
 </div>
 );
 })()}
