 {/* Modals */}
 {showPokerModal && selectedTaskForPoker && sprint.id && (
 <PlanningPokerModal
 isOpen={showPokerModal}
 onClose={() => {
 setShowPokerModal(false);
 setSelectedTaskForPoker(null);
