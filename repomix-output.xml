 <div className="flex-1 px-2 sm:px-4 py-2 space-y-2 overflow-y-auto">
 {/* Sprints (hide completed) */}
 {sprints.filter(s => s.status !== 'completed').map((sprint) => (
 <SprintSection
 key={sprint._id}
 id={sprint._id}
 name={sprint.name}
 startDate={sprint.startDate}
