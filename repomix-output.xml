  BUG = 'bug',
  SUBTASK = 'subtask',
  CHANGE_REQUEST = 'change_request'
}

export enum PMTaskPriority {
  CRITICAL = 'critical',
  HIGH = 'high',
  MEDIUM = 'medium',
  LOW = 'low'
}

export enum PMStatusCategory {
  TODO = 'todo',
  IN_PROGRESS = 'in_progress',
  DONE = 'done'
}

export interface IPMTask {
  _id: mongoose.Types.ObjectId;
