 />
 <span className="text-sm text-foreground">
 {t('projects.board.showLabels') || 'Show Labels'}
 </span>
 </label>

 <label className="flex items-center gap-2 cursor-pointer">
 <input
 type="checkbox"
 checked={settings.showStoryPoints}
