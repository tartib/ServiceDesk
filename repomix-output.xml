  ESCALATION_TRIGGERED = 'escalation_triggered',
  MANUALLY_OVERRIDDEN = 'manually_overridden',
}

export enum SlaEventSource {
  TICKET = 'ticket',
  WORKFLOW = 'workflow',
  SCHEDULER = 'scheduler',
  MANUAL = 'manual',
  SYSTEM = 'system',
