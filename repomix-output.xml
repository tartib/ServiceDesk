export type PMActivityType = 
  | 'task_created' | 'task_updated' | 'task_deleted' | 'task_moved'
  | 'status_changed' | 'assignee_changed' | 'priority_changed'
  | 'comment_added' | 'comment_updated' | 'comment_deleted'
